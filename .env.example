# ---- Copy this file to `.env` and paste your NEWLY ROTATED keys ----
# NEVER commit .env. It is git-ignored. The keys you pasted in chat are burned;
# rotate them first, then fill these in.

# Sarvam (STT + TTS)
SARVAM_API_KEY=

# Google Gemini (LLM brain)
GOOGLE_API_KEY=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# Public URL where this server is reachable by Twilio (e.g. an ngrok https URL,
# WITHOUT trailing slash). Twilio will POST /twiml and connect wss://<host>/ws
PUBLIC_HOST=your-subdomain.ngrok.app

# Voice / model tuning
SARVAM_TTS_MODEL=bulbul:v2
SARVAM_TTS_SPEAKER=anushka
SARVAM_STT_MODEL=saarika:v2.5
GEMINI_MODEL=gemini-2.5-flash
