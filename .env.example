# ---- Copy this file to `.env` and fill in. NEVER commit .env (it is git-ignored). ----
#
# DEFAULT STACK (chosen 28 Sep 2026 after real test calls, ~Rs 2.5/min all-in):
#   Exotel -> Sarvam Saaras v3 (STT) -> Gemini 3.1 Flash-Lite (text) -> Google Chirp 3 HD
#   "Aoede" (voice, streaming). ~2 s from the caller going quiet to Kavya's first sound.
# Every call logs its own cost: grep "CALL COST" in the service log.

# Pipeline: sarvam (Sarvam STT -> Gemini text -> TTS_PROVIDER voice) | gemini-direct (Gemini
# Live: ~1.3 s replies but ~Rs 5.8/min before trimming, ~Rs 3.2/min after) | gemini | hybrid
VOICE_ENGINE=sarvam

# Call language: en (Indian English) | kn (Bengaluru Kanglish). The dashboard can override per call.
CALL_LANGUAGE=en

# Sarvam (STT, and the Bulbul voice if TTS_PROVIDER=sarvam) — one key covers both.
# Saaras v3 Rs 30/hour; Bulbul v3 Rs 30 per 10K characters (Sarvam price list).
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_MODE=codemix
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=kavya

# Voice for the sarvam pipeline:
#   google     -> Google Cloud TTS. Chirp 3 HD voices stream (first audio ~0.19 s);
#                 WaveNet/Standard are cheaper but sounded robotic on a real call.
#   gemini-tts -> Gemini 3.8 Flash-Lite TTS via GOOGLE_API_KEY: ~1/3 of Chirp's cost,
#                 but first audio ~1.1 s (adds ~0.8 s per reply).
#   sarvam     -> Bulbul v3.
# Google Cloud auth, preferred: Workload Identity Federation — point
# GOOGLE_APPLICATION_CREDENTIALS at the external_account config (not a secret). Fallback: a
# service-account key at GCP_KEY_PATH (blocked if the org enforces
# iam.disableServiceAccountKeyCreation).
TTS_PROVIDER=google
GOOGLE_APPLICATION_CREDENTIALS=
GCP_KEY_PATH=gcp-key.json
GOOGLE_TTS_VOICE_EN=en-IN-Chirp3-HD-Aoede
GOOGLE_TTS_VOICE_KN=kn-IN-Chirp3-HD-Aoede
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_VOICE=Aoede

# Google Gemini (writes the replies; also Live and gemini-tts)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# Telephony: exotel | twilio  (the dashboard's "Call now" uses this)
TELEPHONY_PROVIDER=exotel

# Exotel — API key/token from Exotel dashboard > API settings.
# Singapore-region accounts use api.exotel.com, Mumbai uses api.in.exotel.com.
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=api.exotel.com
# your ExoPhone, e.g. 080XXXXXXXX
EXOTEL_CALLER_ID=
# Flow (App) containing a Voicebot applet pointed at wss://<PUBLIC_HOST>/ws
EXOTEL_FLOW_URL=http://my.exotel.com/<sid>/exoml/start_voice/<app_id>

# Twilio (only if TELEPHONY_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# Public host the provider reaches (tunnel or domain), no scheme, no trailing slash
PUBLIC_HOST=your-subdomain.trycloudflare.com

# Dashboard login (HTTP Basic). Leave the password empty only on localhost.
DASHBOARD_USER=artintele
DASHBOARD_PASSWORD=

# Cost trims: predictive cache = an extra Gemini call per turn (no hits on real calls);
# STT gate = only caller speech is streamed to (billed) Sarvam STT (~25-30% of call audio).
PREDICTIVE_CACHE=false
STT_GATE=true
STT_PREROLL_SECS=0.8
# Gemini Live: gating does NOT save money there (silence is not billed) and needs its VAD off.
LIVE_AUDIO_GATE=false

# End-of-speech silence. 0.3 chopped one question into six turns on a real call
# (each fragment transcribed alone -> 'months of EMI' became 'Months of print').
VAD_STOP_SECS=0.55
# Wait this long for the callee's "Hello" before greeting unprompted.
GREETING_WAIT_SECS=2.5

# Cost log calibration: Google bills USD + 18% GST; 92 matched the user's real balance.
USD_INR=92
GST_RATE=0.18
